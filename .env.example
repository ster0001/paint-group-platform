# Copy to .env.local and fill in. Never commit .env.local — it is git-ignored.

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never imported into a "use client" module.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Messaging ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Links + maps ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
GOOGLE_MAPS_API_KEY=

# --- Scheduled sweeps --------------------------------------------------------
# Shared secret for /api/cron/*. Set the same value in the Vercel project env;
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. Without it the
# route refuses every request and the sweeps only run opportunistically (when a
# console page loads), which is enough for development.
CRON_SECRET=

# --- E2E test logins (Playwright, opt-in) ------------------------------------
# Real accounts on the live project; specs skip when these are absent.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
# Inbound bills webhook (Resend/svix signing secret) — Step 6a cost capture
BILLS_INBOUND_SECRET=
# Shared secret for the Airtable/Zapier materials transition sync webhook
AIRTABLE_SYNC_SECRET=
# MYOB Business API integration (Settings → Accounting). From the registered
# MYOB developer app; redirect URL must be <site>/api/myob/callback.
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
# Optional override for local dev (defaults to NEXT_PUBLIC_SITE_URL + /api/myob/callback)
MYOB_REDIRECT_URI=
# Google Calendar sync for contractors (portal → Calendar → Connect). From a
# Google Cloud OAuth client (web application); redirect URL must be
# <site>/api/gcal/callback. See docs/gcal-setup.md for the click-by-click.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override for local dev (defaults to NEXT_PUBLIC_SITE_URL + /api/gcal/callback)
GOOGLE_REDIRECT_URI=

# Error reporting (A4-03). Any HTTPS endpoint that accepts JSON — a Slack or
# Discord incoming webhook is the five-minute option. Unset = console only,
# which is what it was before and means nothing alerts anyone.
# Never point this at a public channel: reports carry a code path and a message.
ERROR_WEBHOOK_URL=
