# Copy to .env.local and fill in. Never commit .env.local — it is git-ignored.

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never imported into a "use client" module.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Messaging ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Links + maps ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
GOOGLE_MAPS_API_KEY=

# --- Scheduled sweeps --------------------------------------------------------
# Shared secret for /api/cron/*. Set the same value in the Vercel project env;
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. Without it the
# route refuses every request and the sweeps only run opportunistically (when a
# console page loads), which is enough for development.
CRON_SECRET=

# --- E2E test logins (Playwright, opt-in) ------------------------------------
# Real accounts on the live project; specs skip when these are absent.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
# Inbound bills webhook (Resend/svix signing secret) — Step 6a cost capture
BILLS_INBOUND_SECRET=
# Shared secret for the Airtable/Zapier materials transition sync webhook
AIRTABLE_SYNC_SECRET=
